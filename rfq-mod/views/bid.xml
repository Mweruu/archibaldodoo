<!-- views/bid_views.xml -->
<odoo>
  <data>
    <record id="view_rfq_bid_form" model="ir.ui.view">
        <field name="name">rfq.bid.form</field>
        <field name="model">rfq.bid</field>
        <field name="arch" type="xml">
            <form string="RFQ Bid">
                <sheet>
                    <group>
                        <field name="rfq_id"/>
                        <field name="vendor_id"/>
                        <field name="bid_amount"/>
                        <field name="bid_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
  </data>
</odoo>

